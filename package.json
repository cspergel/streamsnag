{
  "name": "streamsnag",
  "version": "1.4.0",
  "private": true,
  "description": "StreamSnag: a free, open-source video download helper for Chromium browsers, with optional Claude AI link finding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cspergel/streamsnag.git"
  },
  "homepage": "https://github.com/cspergel/streamsnag",
  "bugs": "https://github.com/cspergel/streamsnag/issues",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "build": "node scripts/build-sdk.js && node scripts/make-icons.js",
    "install-helper": "node native-host/install.js",
    "uninstall-helper": "node native-host/install.js --uninstall",
    "e2e": "node scripts/e2e.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0"
  }
}
