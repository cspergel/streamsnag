{
  "name": "streamsnag",
  "version": "1.7.0",
  "private": true,
  "description": "StreamSnag: a free, open-source video downloader for Chrome, Edge and Brave",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/cspergel/streamsnag.git"
  },
  "homepage": "https://streamsnag.app",
  "bugs": "https://github.com/cspergel/streamsnag/issues",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "build": "node scripts/build-sdk.js && node scripts/make-icons.js",
    "install-helper": "node native-host/install.js",
    "uninstall-helper": "node native-host/install.js --uninstall",
    "build:release": "node scripts/build-release.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "6.5.438",
    "puppeteer-core": "^25.16.0"
  }
}
